{
  // The AIs of the application, from the weakest to the strongest.
  //   id           used by the settings and the sprites (sprites/assignments.json)
  //   name         shown in the application
  //   family       one line: what kind of AI it is
  //   description  shown in the application (default: the .cfg's)
  //   elo          indicative strength (relative scale, mm_player ≈ 1500); only the order matters for now
  //   sprite       default sprite (sprites/sprites.json), when none is assigned
  //   config       engine configuration, relative to config/ (the same .cfg files as the tournaments);
  //                "microseconds" is set by the application (time per move), "nb threads" capped
  //   time factor  the time per move chosen in the application is multiplied by this (default 1)
  //   random moves probability of playing a random legal move instead of thinking (default 0)
  //   overrides    keys replacing those of the .cfg ("weights": "../x" is relative to config/,
  //                other relative paths to the repository)
  //   torch overrides   the same, only when the application is built with libtorch
  //   missing hint shown when the weights file does not exist
//   params       what the player may change before a game (button "Régler"): a key of the
//                configuration, a label, an optional help line and unit, the values offered
//                ("threads": 1 to the cores of the computer; booleans: no / yes); the default is
//                the configuration's. Every AI but "random" also gets "time factor" and
//                "random moves". Saved in the settings, used in games, not in puzzles.
  "ais": [
    { "id": "random", "name": "Hasard", "family": "coups au hasard", "elo": 490, "sprite": "fig_tin_toy",
      "config": "random_player.cfg",
      "description": "Joue un coup au hasard parmi les coups possibles. Idéal pour découvrir le jeu." },
    { "id": "beginner", "name": "Débutant", "family": "Monte Carlo bridé", "elo": 1460, "sprite": "fig_roller",
      "config": "mc_player.cfg", "time factor": 0.02, "random moves": 0.3, "overrides": { "nb threads": 1 },
      "description": "Un Monte Carlo qui réfléchit très peu (2 % du temps, un seul cœur) et joue un coup au hasard trois fois sur dix." },
    { "id": "monte_carlo", "name": "Monte Carlo", "family": "parties aléatoires", "elo": 1970, "sprite": "fig_dicer",
      "config": "mc_player.cfg", "params": [ { "key": "nb threads", "label": "Cœurs (threads)", "values": "threads", "help": "calculs en parallèle" } ],
      "description": "Pour chaque coup possible, joue des milliers de parties au hasard jusqu'à la fin et choisit le coup qui rapporte en moyenne le meilleur écart de points. Aucune connaissance du jeu." },
    { "id": "basic_minmax", "name": "Minimax basique", "family": "minimax + heuristique", "elo": 2220, "elo by depth": { "2": 1960, "3": 2090, "4": 2220, "5": 2380, "6": 2500 }, "sprite": "fig_retro",
      "config": "basic_mm_player.cfg", "params": [ { "key": "depth", "label": "Profondeur", "unit": "demi-coups", "values": [2, 3, 4, 5, 6], "help": "jusqu'où il regarde" } ],
      "description": "Regarde tous les coups jusqu'à une profondeur fixe : 4 demi-coups par défaut (son coup, la réponse, son coup, la réponse), en sautant les branches inutiles (alpha-bêta), puis juge les positions atteintes avec une heuristique écrite à la main. Il n'a pas d'horloge : il réfléchit toujours à la même profondeur, quel que soit le temps donné." },
    { "id": "mcts", "name": "MCTS", "family": "arbre de recherche Monte Carlo", "elo": 2440, "sprite": "fig_tree_bot",
      "config": "mcts_player.cfg", "params": [ { "key": "nb threads", "label": "Cœurs (threads)", "values": "threads", "help": "calculs en parallèle" } ],
      "description": "Construit un arbre de recherche en concentrant les parties aléatoires sur les coups prometteurs (UCT). Plus fort que Monte Carlo à temps égal. Comme toutes les IA de type MCTS, il cherche à gagner, pas à marquer le plus de points : gagner d'un point lui vaut autant que gagner de vingt. C'est censé rendre son jeu plus stable, mais une fois la partie jouée d'avance il peut faire des coups qui surprennent un humain." },
    { "id": "minmax", "name": "Minimax", "family": "minimax + heuristique, recherche rapide", "elo": 2720, "sprite": "fig_chrono",
      "config": "mm_player.cfg", "overrides": { "nb threads": 4 },
      "params": [ { "key": "nb threads", "label": "Cœurs (threads)", "values": "threads", "help": "calculs en parallèle" }, { "key": "tt size", "label": "Table de transposition", "unit": "Mo", "values": [16, 32, 64, 128, 256, 512, 1024], "help": "mémoire des positions déjà vues" } ],
      "description": "Le minimax de référence, longtemps l'un des plus forts. Il cherche à 1 demi-coup, puis 2, puis 3… et s'arrête quand le temps du coup est écoulé (approfondissement itératif). Il se souvient des positions déjà vues (table de transposition), essaie d'abord les coups qui ont déjà réfuté ailleurs (coups tueurs), regarde moins loin les coups les moins prometteurs et fait chercher plusieurs cœurs ensemble (lazy SMP). Il juge les positions avec l'heuristique écrite à la main." },
    { "id": "features", "name": "Minimax Features", "family": "minimax + réseau de features quantifié", "elo": 2830, "sprite": "fig_geometer",
      "config": "mm_features119_quantized_player.cfg", "overrides": { "nb threads": 4 },
      "params": [ { "key": "nb threads", "label": "Cœurs (threads)", "values": "threads", "help": "calculs en parallèle" }, { "key": "tt size", "label": "Table de transposition", "unit": "Mo", "values": [16, 32, 64, 128, 256, 512, 1024], "help": "mémoire des positions déjà vues" } ],
      "description": "Le même minimax, avec un réseau qui lit 119 caractéristiques calculées sur la position (territoire, mobilité, zones), appris sur les résultats des parties et quantifié en entiers 16 bits." },
    { "id": "mcts_nnue", "name": "MCTS NNUE", "family": "MCTS + premier réseau NNUE", "elo": 2880, "sprite": "fig_sylve",
      "config": "mcts_nn_models_player.cfg",
      "params": [ { "key": "nb threads", "label": "Cœurs (threads)", "values": "threads", "help": "calculs en parallèle" } ],
      "description": "L'arbre de recherche Monte Carlo du MCTS, mais au lieu de finir chaque partie au hasard, il demande au premier réseau NNUE (193 entrées, 3 sorties : noir gagne, nulle, blanc gagne, en entiers 8 bits) qui va gagner. Il cherche la victoire, pas le plus gros score (voir MCTS)." },
    { "id": "nnue193", "name": "Minimax NNUE (ancien)", "family": "minimax + réseau NNUE quantifié", "elo": 3020, "sprite": "fig_crt",
      "config": "mm_nnue_quantized_models_player.cfg", "overrides": { "nb threads": 4 },
      "params": [ { "key": "nb threads", "label": "Cœurs (threads)", "values": "threads", "help": "calculs en parallèle" }, { "key": "tt size", "label": "Table de transposition", "unit": "Mo", "values": [16, 32, 64, 128, 256, 512, 1024], "help": "mémoire des positions déjà vues" } ],
      "description": "Minimax avec approfondissement itératif, table de transposition et réductions ; évalue les positions avec le premier réseau NNUE du projet (193 entrées, appris en octobre 2024 sur les résultats des parties du minimax : les Noirs gagnent, nul, les Blancs gagnent), calculé en entiers 8 bits." },
    { "id": "dev", "name": "Minimax NNUE dev", "family": "minimax optimisé + NNUE perspective", "elo": 3570, "sprite": "fig_sentinel",
      "config": "search_study/dev_u8.cfg", "overrides": { "tt size": 128, "nb threads": 4 },
      "params": [ { "key": "nb threads", "label": "Cœurs (threads)", "values": "threads", "help": "calculs en parallèle" }, { "key": "tt size", "label": "Table de transposition", "unit": "Mo", "values": [16, 32, 64, 128, 256, 512, 1024], "help": "mémoire des positions déjà vues" } ],
      "description": "Le minimax le plus travaillé : PVS, fenêtres d'aspiration adaptatives, réductions, élagage, solveur de fin de partie, et un réseau NNUE vu du camp au trait (une première couche par phase, 8 têtes de phase, caractéristiques d'espace). Il ordonne ses coups selon la réponse au dernier coup adverse (historique de continuation, interception) et compte les poches qu'il est seul à pouvoir remplir comme des réserves de coups." },
    { "id": "resnet", "name": "MCTS ResNet", "family": "MCTS + réseau convolutif", "elo": 3600, "sprite": "fig_android",
      "config": "az_vs_nnue/resnet_supervised.cfg", "params": [ { "key": "nb threads", "label": "Cœurs (threads)", "values": "threads", "help": "calculs en parallèle" }, { "key": "batch size", "label": "Positions par lot", "values": [8, 16, 32, 64, 128], "help": "évaluées ensemble par le réseau" } ],
      "description": "Recherche Monte Carlo guidée par un réseau convolutif résiduel (30 blocs de 256 filtres) qui estime la position et les coups probables. Sur GPU avec libtorch ; sur CPU sinon, bien plus lent, donc plus faible à temps égal. Il cherche d'abord la victoire (voir MCTS), mais quand sa recherche voit la fin de la partie, il préfère aussi gagner par plus de points.",
      "overrides": { "backend": "cpu", "weights": "../nnue/cnn_resnet_256x30_value_policy.bin", "score utility": 0.05, "score scale": 10, "nb threads": 8, "batch size": 16 },
      "torch overrides": { "backend": "torch", "weights": "../nnue/cnn_resnet_256x30_value_policy.ts", "score utility": 0.05, "score scale": 10, "nb threads": 16, "batch size": 64 } },
    { "id": "alphazero", "name": "AlphaZero", "family": "MCTS + réseau AlphaZero", "elo": 3610, "sprite": "fig_core",
      "config": "az_vs_nnue/az256.cfg", "params": [ { "key": "nb threads", "label": "Cœurs (threads)", "values": "threads", "help": "calculs en parallèle" }, { "key": "batch size", "label": "Positions par lot", "values": [8, 16, 32, 64, 128], "help": "évaluées ensemble par le réseau" } ],
      "description": "Le même MCTS, avec le réseau qu'AlphaZero a entraîné en jouant contre lui-même à partir du réseau supervisé. Il cherche d'abord la victoire (voir MCTS), mais quand sa recherche voit la fin de la partie, il préfère aussi gagner par plus de points.",
      "overrides": { "backend": "cpu", "weights": "models/az_00271360.bin", "score utility": 0.05, "score scale": 10, "nb threads": 8, "batch size": 16 },
      "torch overrides": { "backend": "torch", "weights": "models/az_00271360.ts", "score utility": 0.05, "score scale": 10, "nb threads": 16, "batch size": 64 } }
  ],
  // The engine behind the evaluation bar, the hint and the principal variation.
  "analysis": { "config": "search_study/dev_u8.cfg", "overrides": { "tt size": 64 } }
}
