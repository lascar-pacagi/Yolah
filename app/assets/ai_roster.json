{
  // The AIs of the application, from the weakest to the strongest.
  //   id           used by the settings and the sprites
  //   name         shown in the application
  //   family       one line: what kind of AI it is
  //   elo          indicative strength (relative scale, mm_player ≈ 1500),
  //                from the grading tournament and the later matches; only the
  //                order matters for now
  //   sprite       id of a sprite of sprites/sprites.json
  //   config       engine configuration, relative to config/ (the same .cfg
  //                files as the tournaments); "microseconds" is set by the
  //                application (time per move), "nb threads" capped
  //   overrides    keys replacing those of the .cfg ("weights": "../x" is
  //                relative to config/, other relative paths to the repository)
  //   torch overrides   the same, only in a build with -DYOLAH_APP_TORCH=ON
  //   description  shown in the application (default: the .cfg's)
//   missing hint shown when the weights file does not exist
  "ais": [
    { "id": "monte_carlo", "description": "Pour chaque coup possible, joue des milliers de parties au hasard jusqu'\u00e0 la fin et choisit le coup qui gagne le plus souvent. Aucune connaissance du jeu.", "name": "Monte Carlo", "family": "parties aléatoires", "elo": 1150,
      "sprite": "monte_carlo", "config": "mc_player.cfg" },
    { "id": "mcts", "description": "Construit un arbre de recherche en concentrant les parties al\u00e9atoires sur les coups prometteurs (UCT). Plus fort que Monte Carlo \u00e0 temps \u00e9gal.", "name": "MCTS", "family": "arbre de recherche Monte Carlo", "elo": 1250,
      "sprite": "mcts", "config": "mcts_player.cfg" },
    { "id": "basic_minmax", "description": "Examine tous les coups jusqu'\u00e0 4 demi-coups (alpha-b\u00eata) et juge les positions avec une heuristique \u00e9crite \u00e0 la main.", "name": "Minimax basique", "family": "minimax + heuristique", "elo": 1350,
      "sprite": "basic_minmax", "config": "basic_mm_player.cfg" },
    { "id": "nnue193", "description": "Minimax avec approfondissement it\u00e9ratif, table de transposition et r\u00e9ductions ; \u00e9value les positions avec un r\u00e9seau NNUE (193 entr\u00e9es) distill\u00e9 d'un r\u00e9seau convolutif et calcul\u00e9 en entiers.", "name": "Minimax NNUE (ancien)", "family": "minimax + réseau NNUE quantifié", "elo": 1770,
