Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

# ── alphazero_learn.def — toolchain image for the AlphaZero learning loop ─────
#
# Build (needs root or --fakeroot, no GPU needed):
#     sudo singularity build alphazero_learn.sif alphazero_learn.def
#
# Unlike the other .def files, the Yolah sources are NOT baked into the image:
# the job bind-mounts the repository at /Yolah and compiles the C++ part
# (alphazero_learn) on the compute node at the start of every job (a couple of
# minutes, cached per CPU model in the work directory). Two reasons:
#   • the CMake flags use -march=native: a binary compiled on the machine that
#     builds the image may use instructions the cluster CPUs lack (SIGILL);
#   • a code change needs a `git pull` on the cluster, not an image rebuild.
#
# Contents: CUDA 12.4 + cuDNN (headers for libtorch's CMake config), g++-13
# (the code is C++23: <format>, std::jthread ...), Boost, oneTBB, Google
# benchmark, CMake, Python 3 with torch 2.6.0 — whose wheel also provides
# libtorch (headers + CMake package) for the C++ TorchScript backend.
#
# See alphazero_learn.sh for the SLURM glue and
# player/README_ALPHAZERO_LEARN.md for the whole loop.

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y --no-install-recommends software-properties-common gpg-agent ca-certificates
    # g++-13: Ubuntu 22.04 ships g++-11, which lacks <format>.
    add-apt-repository -y ppa:ubuntu-toolchain-r/test
    apt-get update -y
    apt-get install -y --no-install-recommends \
        g++-13 gcc-13 make cmake git \
        libboost-program-options-dev libtbb-dev libbenchmark-dev \
        python3 python3-dev python3-pip
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-13 100
    rm -rf /var/lib/apt/lists/*

    pip3 install --no-cache-dir --upgrade pip
    # torch 2.6.0 bundles the CUDA 12.4 runtime, which the cluster driver
    # supports (see cnn_resnet_value_policy.def). Keep the two pins together.
    pip3 install --no-cache-dir torch==2.6.0 numpy tqdm

    # Build-time sanity checks.
    g++ --version | head -1
    cmake --version | head -1
    python3 -c "import torch; print('torch', torch.__version__, torch.utils.cmake_prefix_path)"

    mkdir -p /Yolah /work

%environment
    export CUDA_HOME=/usr/local/cuda
    export PATH=$CUDA_HOME/bin:$PATH
    export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
    export CC=gcc-13
    export CXX=g++-13
    # Only used to skip libtorch's CMake GPU probe (see CMakeLists.txt):
    # Turing, Ampere, Ada, Hopper.
    export TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0"
    export TORCH_ALLOW_TF32=1
