Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

# ── What gets baked into the image ───────────────────────────────────────────
# The combined network needs BOTH encoders at preprocess time:
#   1. The Python yolah module (under /server) to replay each game and produce
#      the 193-input board encoding.
#   2. A native binary /usr/local/bin/encode_features that links
#      yolah_features.cpp + the minimal Yolah game core (game/magic/zobrist/move)
#      to produce the 119-byte feature records. The shim header at
#      nnue/encoder_shim/generate_games.h breaks yolah_features.cpp's transitive
#      dependency on player.h.
# preprocess_combined.py runs the C++ encoder (Phase A) then replays each game in
# Python (Phase B), joining the 193-input and 119-features into ONE row-aligned
# cache with per-row TURN/VALUE alignment checks.
#
# The games data lives under nnue/data and is baked in via `../nnue /nnue`
# (read at /nnue/data). The cache (/cache) and model dir (/mnt) are bind-mounted.
#
# Typical invocation:
#   singularity exec \
#     --bind ./cache:/cache \
#     combined_net311x1024x64x32x1.sif \
#     bash -c "cd /nnue && python3 preprocess_combined.py /cache"
#
#   singularity exec --nv \
#     --bind ./cache:/cache \
#     --bind ./models:/mnt \
#     combined_net311x1024x64x32x1.sif python3 /nnue/combined_net311x1024x64x32x1.py
#
# See combined_net311x1024x64x32x1.sh for the SLURM glue.

%files
    ../server /server
    ../nnue   /nnue
    ../player /yolah_src/player
    ../game   /yolah_src/game
    ../misc   /yolah_src/misc

%post
    # Fail fast on any apt/pip/build error.
    set -eu

    DEBIAN_FRONTEND=noninteractive apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-pip \
        python3-setuptools \
        build-essential \
        g++ \
        git \
        ca-certificates
    rm -rf /var/lib/apt/lists/*

    pip3 install --no-cache-dir --upgrade pip

    # PyTorch from the default PyPI index, pinned to 2.6.0. That release's
    # Linux x86_64 wheel bundles the CUDA 12.4 runtime, which matches the
    # cluster's NVIDIA driver (it supports up to CUDA 12.4 — reported by
    # torch as "12040"). torch 2.7+ bundles CUDA 12.6, needing a newer
    # driver than the cluster has -> "driver too old" at CUDA init.
    # Raise this pin only after the cluster driver is upgraded.
    pip3 install --no-cache-dir torch==2.6.0

    pip3 install --no-cache-dir numpy tqdm

    # ── Build the encode_features CLI ────────────────────────────────────────
    # We need C++23 for the std::format usage inside yolah_features.cpp's
    # debug code paths. Ubuntu 22.04's default g++ (11.x) is enough for our
    # use because all std::format references are inside `#ifndef NDEBUG`
    # blocks and we compile with -DNDEBUG. The encoder_shim/ directory holds
    # a stub generate_games.h that exposes only `data::decode_game`, breaking
    # yolah_features.cpp's transitive dependency on player.h (which would
    # otherwise drag in the entire Yolah build tree).
    g++ -std=c++23 -O3 -DNDEBUG -march=native -fopenmp \
        -I/nnue/encoder_shim \
        -I/yolah_src/player \
        -I/yolah_src/game \
        -I/yolah_src/misc \
        /nnue/encode_features_cli.cpp \
        /yolah_src/player/yolah_features.cpp \
        /yolah_src/game/game.cpp \
        /yolah_src/game/magic.cpp \
        /yolah_src/game/zobrist.cpp \
        /yolah_src/game/move.cpp \
        -o /usr/local/bin/encode_features
    chmod +x /usr/local/bin/encode_features

    # Build-time sanity checks: fail the build if these are broken, not at
    # SLURM submit time.
    python3 -c "import torch; print('torch', torch.__version__)"
    python3 -c "import numpy, tqdm; print('numpy', numpy.__version__)"
    /usr/local/bin/encode_features 2>&1 | head -3 || true   # prints usage

    # Placeholder dirs that get shadowed by bind mounts at runtime.
    mkdir -p /cache /mnt

%environment
    export CUDA_HOME=/usr/local/cuda
    export PATH=$CUDA_HOME/bin:$PATH
    export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
    export TORCH_ALLOW_TF32=1
    # preprocess_combined.py looks here for the encoder by default.
    export YOLAH_ENCODER_BIN=/usr/local/bin/encode_features

%runscript
    # Default action when running `singularity run` with no override.
    # The .sh launcher uses `exec` with an explicit command, so this is
    # only a convenience fallback.
    cd /nnue
    python3 combined_net311x1024x64x32x1.py
